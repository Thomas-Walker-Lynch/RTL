#!/usr/bin/env python3
import sys
import subprocess
import glob

def execute_test_suite():
  print("test_CLI version: 1.0.3\n")

  test_fpa_list = []

  if( len(sys.argv) > 1 ):
    for i in range( 1, len(sys.argv) ):
      if( sys.argv[i].endswith(".js") ):
        test_fpa_list.append(sys.argv[i])
  else:
    test_fpa_list = glob.glob("test_*.js")
    test_fpa_list.sort()

  if( len(test_fpa_list) == 0 ):
    print("No tests found.")
    return False

  print("found:")
  for i in range( len(test_fpa_list) ):
    print(f"   {test_fpa_list[i]}")
  print("")

  passed_count = 0
  failed_count = 0

  for i in range( len(test_fpa_list) ):
    current_test_fpa = test_fpa_list[i]

    process_result = subprocess.run(
      [
        "node"
        ,current_test_fpa
      ]
      ,capture_output=True
      ,text=True
    )

    test_passed_bool = True

    if(process_result.returncode != 0):
      test_passed_bool = False

    if( len(process_result.stdout) > 0 ):
      test_passed_bool = False

    if( len(process_result.stderr) > 0 ):
      test_passed_bool = False

    if(test_passed_bool):
      passed_count += 1
    else:
      if(failed_count == 0):
        print("failed:")
        
      failed_count += 1
      print(f"   {current_test_fpa}")

      if( len(process_result.stdout) > 0 ):
        stdout_line_list = process_result.stdout.strip().split('\n')
        for msg_i in range( len(stdout_line_list) ):
          if( len(stdout_line_list[msg_i]) > 0 ):
            print(f"      {stdout_line_list[msg_i]}")

      if( len(process_result.stderr) > 0 ):
        stderr_line_list = process_result.stderr.strip().split('\n')
        for msg_i in range( len(stderr_line_list) ):
          if( len(stderr_line_list[msg_i]) > 0 ):
            print(f"      stderr: {stderr_line_list[msg_i]}")
      
      sys.stdout.flush()

  if(failed_count == 0):
    print("failed:\n   none")

  print("\nsummary:")
  print(f"    passed: {passed_count}")
  print(f"    failed: {failed_count}")

  if(failed_count > 0):
    return False
  return True

if __name__ == "__main__":
  success_bool = execute_test_suite()
  if(not success_bool):
    sys.exit(1)
  sys.exit(0)
